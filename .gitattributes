# Git Attributes — 统一行尾和 diff 行为
# https://git-scm.com/docs/gitattributes

# 默认：自动检测文本/二进制，文本文件在 checkout 时转换为本地行尾
* text=auto

# Go 源码：强制 LF（Go 工具链和 CI 均期望 LF）
*.go text eol=lf

# TypeScript / JavaScript / JSON / YAML / Markdown：强制 LF
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Windows 脚本：保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件：不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
