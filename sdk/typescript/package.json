{
    "name":  "@agentprimordia/sdk",
    "version":  "2.0.0",
    "description":  "AgentPrimordia - Universal AI Agent Development Framework for TypeScript",
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "build":  "tsup",
                    "prepublishOnly":  "npm run build",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "bench":  "vitest bench",
                    "lint":  "eslint src/",
                    "lint:fix":  "eslint src/ --fix",
                    "typecheck":  "tsc --noEmit",
                    "docs:dev":  "vitepress dev docs",
                    "docs:build":  "vitepress build docs",
                    "docs:preview":  "vitepress preview docs"
                },
    "keywords":  [
                     "agent",
                     "ai",
                     "llm",
                     "react-loop",
                     "tool-system",
                     "multi-agent",
                     "framework"
                 ],
    "license":  "Apache-2.0",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/agentprimordia/ap.git",
                       "directory":  "sdk/typescript"
                   },
    "homepage":  "https://github.com/agentprimordia/ap#readme",
    "engines":  {
                    "node":  "\u003e=18.0.0"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.4",
                            "@types/node":  "^25.9.1",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@vitest/coverage-v8":  "^1.6.1",
                            "eslint":  "^9.39.4",
                            "react":  "^19.2.7",
                            "react-dom":  "^19.2.7",
                            "tsup":  "^8.5.1",
                            "typescript":  "^5.4.0",
                            "typescript-eslint":  "^8.62.0",
                            "vitepress":  "^1.3.0",
                            "vitest":  "^1.6.0"
                        },
    "peerDependencies":  {
                             "better-sqlite3":  "^11.0.0",
                             "react":  "^18.0.0 || ^19.0.0",
                             "react-dom":  "^18.0.0 || ^19.0.0"
                         },
    "peerDependenciesMeta":  {
                                 "better-sqlite3":  {
                                                        "optional":  true
                                                    },
                                 "react":  {
                                               "optional":  true
                                           },
                                 "react-dom":  {
                                                   "optional":  true
                                               }
                             },
    "dependencies":  {
                         "zod":  "^3.24.0",
                         "zod-to-json-schema":  "^3.24.0"
                     },
    "sideEffects":  false,
    "exports":  {
                    "./llm":  {
                                  "types":  "./dist/llm/index.d.ts",
                                  "import":  "./dist/llm/index.js"
                              },
                    "./tools":  {
                                    "types":  "./dist/tools/index.d.ts",
                                    "import":  "./dist/tools/index.js"
                                },
                    "./agent":  {
                                    "types":  "./dist/agent/index.d.ts",
                                    "import":  "./dist/agent/index.js"
                                },
                    "./orchestration":  {
                                            "types":  "./dist/orchestration/index.d.ts",
                                            "import":  "./dist/orchestration/index.js"
                                        },
                    ".":  {
                              "require":  "./dist/index.cjs",
                              "default":  "./dist/index.js",
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                }
}
