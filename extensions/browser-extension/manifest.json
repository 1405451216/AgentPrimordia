{
    "manifest_version": 3,
    "name": "AgentPrimordia DevTools",
    "version": "5.0.0",
    "description": "Inspect and interact with AgentPrimordia agents on any webpage",
    "permissions": ["activeTab", "storage", "scripting"],
    "host_permissions": ["http://localhost:8765/*", "http://localhost:6060/*"],
    "background": {
        "service_worker": "dist/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["dist/content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "dist/popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "devtools_page": "dist/devtools/devtools.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
