{
  "name": "@agentprimordia/browser-extension",
  "version": "5.0.0",
  "description": "AgentPrimordia Agent DevTools Browser Extension (Chrome/Firefox)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && bestzip extension-v$npm_package_version.zip dist/ icons/ manifest.json"
  },
  "keywords": [
    "agentprimordia",
    "browser-extension",
    "devtools",
    "agent",
    "ai",
    "chrome-extension",
    "firefox-extension",
    "mv3"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentprimordia/ap.git",
    "directory": "sdk/browser-extension"
  },
  "homepage": "https://github.com/agentprimordia/ap/tree/main/sdk/browser-extension",
  "devDependencies": {
    "@types/chrome": "^0.0.260.0",
    "bestzip": "^2.2.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}