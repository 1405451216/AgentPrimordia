{
  "version": "1.0",
  "plugins": [
    {
      "name": "http",
      "version": "0.7.0",
      "description": "增强型 HTTP 客户端，支持 REST API 调用、认证、重试和响应处理",
      "category": "network",
      "import_path": "agentprimordia/ecosystem/plugins/http",
      "tools": ["http_client"],
      "tags": ["http", "rest", "api", "network"]
    },
    {
      "name": "sql",
      "version": "0.7.0",
