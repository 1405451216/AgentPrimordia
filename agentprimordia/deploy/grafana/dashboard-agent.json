{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "活跃 Agent 数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ap_active_agents",
          "legendFormat": "{{agent_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "LLM 调用延迟 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ap_llm_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ap_llm_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ap_llm_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "工具调用频率",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(increase(ap_tool_total_calls_total[1h])) by (tool_name)",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "title": "轮次延迟分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ap_turn_duration_ms_bucket[5m])) by (le, agent_name))",
          "legendFormat": "{{agent_name}} P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ap_turn_duration_ms_bucket[5m])) by (le, agent_name))",
          "legendFormat": "{{agent_name}} P95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "title": "LLM 错误率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(ap_llm_total_calls{status=\"error\"}[5m])) / sum(rate(ap_llm_total_calls[5m]))",
          "legendFormat": "错误率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["agentprimordia", "agent"],
  "templating": {
    "list": [
      {
        "name": "agent_name",
        "type": "query",
        "query": "label_values(ap_active_agents, agent_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "provider",
        "type": "query",
        "query": "label_values(ap_llm_total_calls, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "model",
        "type": "query",
        "query": "label_values(ap_llm_total_calls, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "AgentPrimordia - Agent Runtime",
  "uid": "ap-agent-runtime"
}
