{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "总成本 (USD)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(ap_cost_total_dollars)",
          "legendFormat": "总计"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "title": "按 Provider 成本",
      "type": "barchart",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(ap_cost_total_dollars) by (provider)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "title": "成本趋势",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(increase(ap_cost_total_dollars[1h])) by (provider)",
          "legendFormat": "{{provider}} 每小时"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      }
    },
    {
      "title": "按 Agent 成本",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(ap_cost_total_dollars) by (agent_name, provider, model)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "agent_name": "Agent",
              "provider": "Provider",
              "model": "Model",
              "Value": "成本 (USD)"
            }
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["agentprimordia", "cost"],
  "time": { "from": "now-24h", "to": "now" },
  "title": "AgentPrimordia - Cost Tracking",
  "uid": "ap-cost-tracking"
}
