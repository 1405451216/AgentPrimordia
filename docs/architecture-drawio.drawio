        <mxCell id="rel_msg_tr" value="0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;dashed=1;" edge="1" source="class_message" target="class_toolresult" parent="1">
          <mxGeometry relative="1" as="geometry" />
