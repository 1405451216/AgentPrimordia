        <!-- 开始节点 -->
        <mxCell id="start" value="初始化&lt;br&gt;创建 SubAgent" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- LLM 调用 -->
        <mxCell id="llm_call" value="&lt;b&gt;LLM 调用&lt;/b&gt;&lt;br&gt;(含工具描述)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- 解析响应 -->
        <mxCell id="parse_resp" value="&lt;b&gt;解析响应&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- 判断节点 -->
        <mxCell id="decision" value="响应含&lt;br&gt;&lt;b&gt;tool_calls&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="370" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- 执行工具 -->
        <mxCell id="exec_tool" value="&lt;b&gt;执行工具&lt;/b&gt;&lt;br&gt;read/write/edit/run/search/web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="385" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- 观察结果 -->
        <mxCell id="observe_result" value="&lt;b&gt;观察结果&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="485" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 追加消息 -->
        <mxCell id="append_msg" value="&lt;b&gt;追加消息到历史&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="565" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 任务完成 -->
        <mxCell id="task_complete" value="&lt;b&gt;任务完成&lt;/b&gt;&lt;br&gt;返回结果" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="385" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 失败判断 -->
        <mxCell id="fail_decision" value="超过 maxTurns&lt;br&gt;或出错?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="515" y="545" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- 标记失败 -->
        <mxCell id="mark_failed" value="&lt;b&gt;标记失败&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="555" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- 循环箭头标签 -->
        <mxCell id="loop_label" value="循环 (maxTurns=50)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="430" width="130" height="25" as="geometry" />
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="start" target="llm_call" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="llm_call" target="parse_resp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="parse_resp" target="decision" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f4_yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#b85450;fontStyle=1;" edge="1" source="decision" target="exec_tool" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f5_no" value="否 (纯文本)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontColor=#82b366;fontStyle=1;" edge="1" source="decision" target="task_complete" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="exec_tool" target="observe_result" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="observe_result" target="append_msg" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;curved=1;" edge="1" source="append_msg" target="llm_call" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="590" />
              <mxPoint x="310" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="decision" target="fail_decision" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="f10_yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#b85450;fontStyle=1;" edge="1" source="fail_decision" target="mark_failed" parent="1">
