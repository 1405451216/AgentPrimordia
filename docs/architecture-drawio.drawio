        <mxCell id="rel_pool_sa" value="manages&lt;br&gt;1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=diamond;endFill=0;" edge="1" source="class_pool" target="class_subagent" parent="1">
