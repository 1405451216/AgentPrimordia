        <!-- 关系连线 -->
        <mxCell id="rel_sa_msg" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" source="class_subagent" target="class_message" parent="1">
          <mxGeometry relative="1" as="geometry" />
